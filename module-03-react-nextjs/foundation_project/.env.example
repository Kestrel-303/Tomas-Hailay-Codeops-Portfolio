# Copy to .env.local and fill in. Both are server-only (no NEXT_PUBLIC_ prefix).
# Generate each value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Signs the ae_session cookie that owns orders.
SESSION_SECRET=

# Shared with the payment provider; verifies POST /api/payments/confirm signatures.
PAYMENT_WEBHOOK_SECRET=

# Optional: the public address, no trailing slash (e.g. https://addiseats.et). metadataBase, the
# link-preview card URLs, canonical links and the sitemap are built from it at BUILD time.
# On Vercel leave it unset unless you add a custom domain (then set it for Production only):
# a Production build uses the production domain and a Preview build its own URL (lib/site.js).
# Locally it falls back to http://localhost:3000.
SITE_URL=
