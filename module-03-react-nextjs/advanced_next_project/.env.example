# Every variable Addis Eats needs. Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real values, and never prefix a secret with
# NEXT_PUBLIC_ (that would copy it into the JavaScript sent to every browser).

# Signs the session cookie (lib/session.js). Server-only, at least 32 characters.
# Required by `npm run dev`, `npm run build` and `npm start`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The site's public address, with no trailing slash, e.g. https://addis-eats.example.com.
# metadataBase, canonical links, og:image tags, the sitemap and JSON-LD are all built from it,
# so link previews and search engines get absolute production URLs. Not secret. If it's unset,
# Vercel's production domain is used, and then http://localhost:3000 for local development.
SITE_URL=
