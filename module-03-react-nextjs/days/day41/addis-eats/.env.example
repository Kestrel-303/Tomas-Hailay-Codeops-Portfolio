# Copy to .env.local. Signs the session cookie; required when NODE_ENV=production (next build / next start).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The site's public address, with no trailing slash (e.g. https://addis-eats.example.com).
# metadataBase, og:image URLs, the sitemap, robots.txt and JSON-LD are built from it. Not secret.
# Unset: Vercel's production domain is used, then http://localhost:3000.
SITE_URL=
