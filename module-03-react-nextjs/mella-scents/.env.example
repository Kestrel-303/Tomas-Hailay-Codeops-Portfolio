# Every variable Mella Scents reads. Copy this file to .env.local and fill it in:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit a real value, and never give a secret a NEXT_PUBLIC_
# prefix (that would copy it into the JavaScript every browser downloads).

# Required. Signs the ms_session cookie (lib/session-token.js). Server-only, 32+ characters.
# On Vercel: a different value for Production and for Preview. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. The public address, no trailing slash (e.g. https://mellascents.et). Link cards,
# canonical URLs, JSON-LD and the sitemap are built from it at BUILD time. Leave it unset on
# Vercel unless you add a custom domain (then Production only): a Production build uses the
# production domain and a Preview build its own URL (lib/site.js). Locally: http://localhost:3000.
SITE_URL=
